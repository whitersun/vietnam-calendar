# top-most EditorConfig file
root = true

# All files default settings
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Language specific overrides

# Python files (4-space indentation)
[*.py]
indent_size = 4

# Makefiles (Tabs required)
[Makefile]
indent_style = tab

# Markdown files (Trailing spaces can be significant)
[*.md]
trim_trailing_whitespace = false
